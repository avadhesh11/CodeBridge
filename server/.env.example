# =======================================================
# CodeBridge Environment Configuration Template (.env.example)
# Use this template for both API and Execution Worker deployments.
# =======================================================

# Port for Express API Service (Render / Local)
PORT=5000

# Frontend origins allowed by CORS (comma-separated)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Backend URL for OAuth redirects and public links
BACKEND_URL=http://localhost:5000

# MongoDB Connection String (shared by API and Worker)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codebridge?retryWrites=true&w=majority

# Redis Connection URL (BullMQ, Socket.IO adapter, and Pub/Sub)
# Format: redis://:<password>@<host>:<port> or rediss:// for TLS (e.g. Upstash)
REDIS_URL=redis://127.0.0.1:6379

# JWT Secrets for authentication and sessions
ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars

# GitHub OAuth Credentials (optional for local/test)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Enable BullMQ Admin Dashboard at /admin/queues (true/false)
ENABLE_QUEUE_BOARD=false

# =======================================================
# Execution Worker Specific Configuration (AWS EC2 / Render Fallback)
# =======================================================

# Execution Runner Mode:
#   - "docker" : Strict Docker isolation (RECOMMENDED for AWS EC2)
#   - "native" : Native Linux host execution with ulimit (Render fallback)
#   - "auto"   : Auto-detects Docker daemon, falls back to native if missing
EXECUTION_RUNNER=auto

# Worker Concurrency: Number of jobs processed simultaneously.
# Keep 1 on low-memory instances (512MB RAM) to avoid OOM killer.
WORKER_CONCURRENCY=1

# Docker volume name if using named volume for temporary code files
# TEMP_VOLUME_NAME=codebridge_temp_data
