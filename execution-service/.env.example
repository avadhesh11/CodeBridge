# =======================================================
# Execution Service Environment Configuration (.env.example)
# =======================================================

# MongoDB Connection String (Atlas or dedicated MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codebridge?retryWrites=true&w=majority

# Redis Connection URL (BullMQ and Pub/Sub)
REDIS_URL=redis://127.0.0.1:6379

# Execution Runner Mode:
#   - "docker" : Strict Docker isolation (RECOMMENDED for AWS EC2)
#   - "native" : Native Linux host execution with ulimit (Render fallback)
#   - "auto"   : Auto-detects Docker daemon, falls back to native if missing
EXECUTION_RUNNER=auto

# Worker Concurrency: Number of jobs processed simultaneously.
# Keep 1 on low-memory instances (512MB RAM) to avoid OOM killer.
WORKER_CONCURRENCY=1
